{
  "name": "openstudy",
  "version": "0.1.0",
  "description": "A focused terminal study assistant",
  "main": "dist/index.js",
  "bin": {
    "openstudy": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "bun": ">=1.3",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItriIbouanane/openstudy.git"
  },
  "bugs": {
    "url": "https://github.com/ItriIbouanane/openstudy/issues"
  },
  "homepage": "https://github.com/ItriIbouanane/openstudy#readme",
  "scripts": {
    "dev": "bun src/index.tsx",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "bun dist/index.js",
    "reset": "node scripts/reset-config.mjs",
    "reset:all": "node scripts/reset-config.mjs --all",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test tests/",
    "test:watch": "bun test --watch tests/",
    "audit": "bun audit --audit-level high",
    "package:check": "node scripts/check-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run package:check",
    "prepack": "npm run check"
  },
  "keywords": [
    "ai",
    "education",
    "study",
    "tui",
    "cli",
    "terminal",
    "opencode",
    "opentui"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "dependencies": {
    "@opencode-ai/sdk": "^1.14.34",
    "@opentui/core": "^0.5.6",
    "@opentui/react": "^0.5.6",
    "marked": "^17.0.6",
    "react": "^19.2.5",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "typescript": "^6.0.3"
  }
}
