{
  "name": "openstudy",
  "version": "0.1.0",
  "description": "A focused terminal study assistant",
  "main": "dist/index.js",
  "bin": {
    "openstudy": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItriIbouanane/openstudy.git"
  },
  "bugs": {
    "url": "https://github.com/ItriIbouanane/openstudy/issues"
  },
  "homepage": "https://github.com/ItriIbouanane/openstudy#readme",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "reset": "node scripts/reset-config.mjs",
    "reset:all": "node scripts/reset-config.mjs --all",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "audit": "npm audit --omit=dev --audit-level=high",
    "package:check": "node scripts/check-package.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run package:check",
    "prepack": "npm run check"
  },
  "keywords": [
    "ai",
    "education",
    "study",
    "tui",
    "cli",
    "terminal",
    "opencode",
    "ink"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "dependencies": {
    "@opencode-ai/sdk": "^1.14.34",
    "ai": "6.0.237",
    "ai-sdk-provider-codex-cli": "1.3.1",
    "ink": "^7.0.1",
    "marked": "^17.0.6",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "4.0.40"
  }
}
